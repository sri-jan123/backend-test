<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
</head>
<body>
    <a href="/users/new">create a new user</a>
    <div class="container">
       <%for(let user of users){ %>
       <div class="box">
        <h1><%= user.username%></h1>
        <h3><%= user.password%></h3>
        <h3><%= user.city%></h3>
       </div>
       <% } %>
    </div>
</body>
</html>

